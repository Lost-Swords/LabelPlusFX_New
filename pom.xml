<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
>
    <modelVersion>4.0.0</modelVersion>

    <groupId>ink.meodinger</groupId>
    <artifactId>lpfx</artifactId>
    <version>2.3.7</version>
    <packaging>jar</packaging>

    <name>lpfx</name>

    <developers>
        <developer>
            <timezone>GMT+8:00</timezone>
            <name>Meodinger Wang</name>
            <email>meodinger@std.uestc.edu.cn</email>
            <roles>
                <role>Developer</role>
            </roles>
        </developer>
    </developers>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <kotlin.code.style>official</kotlin.code.style>
        <kotlin.compiler.jvmTarget>17</kotlin.compiler.jvmTarget>
        <kotlin.compiler.incremental>true</kotlin.compiler.incremental>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.source>17</maven.compiler.source>
    </properties>

    <repositories>
        <repository>
            <id>mavenCentral</id>
            <url>https://repo1.maven.org/maven2/</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>

        <!-- Kotlin Libraries -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib</artifactId>
            <version>2.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib-jdk7</artifactId>
            <version>2.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib-jdk8</artifactId>
            <version>2.0.0</version>
        </dependency>

        <!-- Jakarta Mail -->
        <dependency>
            <groupId>com.sun.mail</groupId>
            <artifactId>jakarta.mail</artifactId>
            <version>2.0.1</version>
        </dependency>

        <!-- JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>2.13.4</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>2.13.4</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.13.4.2</version>
        </dependency>

        <!--imageio-->
        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-webp</artifactId>
            <version>3.12.0</version>
        </dependency>

        <!--jsoup-->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.20.1</version>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <resources>
            <!-- Configure resource filtering for main resources -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <excludes>
                    <exclude>**/*.zip</exclude>
                    <exclude>**/*.bin</exclude>
                    <exclude>**/*.psd</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <includes>
                    <include>**/*.zip</include>
                </includes>
            </resource>
        </resources>
        <sourceDirectory>src/main/kotlin</sourceDirectory>
        <testSourceDirectory>src/test/kotlin</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.moditect</groupId>
                <artifactId>moditect-maven-plugin</artifactId>
                <version>1.2.2.Final</version>

                <executions>
                    <execution>
                        <!-- Add module info for TwelveMonkeys imageio-webp -->
                        <id>module-imageio-webp</id>
                        <goals>
                            <goal>add-module-info</goal>
                        </goals>
                        <phase>package</phase>
                        <configuration>
                            <!-- Output directory set to build folder -->
                            <outputDirectory>${project.build.directory}/build</outputDirectory>
                            <!-- Overwrite existing files -->
                            <overwriteExistingFiles>true</overwriteExistingFiles>
                            <!-- Ignore warnings during build -->
                            <failOnWarning>false</failOnWarning>
                            <!-- Additional jdeps arguments -->
                            <jdepsExtraArgs>
                                <arg>--module-path</arg>
                                <arg>${project.build.directory}/build</arg>
                                <arg>--ignore-missing-deps</arg>
                                <arg>--multi-release</arg>
                                <arg>17</arg>
                            </jdepsExtraArgs>
                            <!-- Module configurations -->
                            <modules>
                                <!-- Module: com.twelvemonkeys.common.lang -->
                                <module>
                                    <artifact>
                                        <groupId>com.twelvemonkeys.common</groupId>
                                        <artifactId>common-lang</artifactId>
                                    </artifact>
                                    <moduleInfo>
                                        <name>com.twelvemonkeys.common.lang</name>
                                        <requires>static java.desktop</requires>
                                    </moduleInfo>
                                </module>
                                <!-- Module: com.twelvemonkeys.common.io -->
                                <module>
                                    <artifact>
                                        <groupId>com.twelvemonkeys.common</groupId>
                                        <artifactId>common-io</artifactId>
                                    </artifact>
                                    <moduleInfo>
                                        <name>com.twelvemonkeys.common.io</name>
                                        <requires>static java.desktop;</requires>
                                    </moduleInfo>
                                </module>
                                <!-- Module: com.twelvemonkeys.common.image -->
                                <module>
                                    <artifact>
                                        <groupId>com.twelvemonkeys.common</groupId>
                                        <artifactId>common-image</artifactId>
                                    </artifact>
                                    <moduleInfo>
                                        <name>com.twelvemonkeys.common.image</name>
                                        <requires>static java.desktop;</requires>
                                        <exports>com.twelvemonkeys.image;</exports>
                                    </moduleInfo>
                                </module>
                                <!-- Module: com.twelvemonkeys.imageio.core -->
                                <module>
                                    <artifact>
                                        <groupId>com.twelvemonkeys.imageio</groupId>
                                        <artifactId>imageio-core</artifactId>
                                        <version>3.12.0</version>
                                    </artifact>
                                    <moduleInfo>
                                        <name>com.twelvemonkeys.imageio.core</name>
                                        <requires>
                                            static java.desktop;
                                            com.twelvemonkeys.common.lang;
                                            com.twelvemonkeys.common.image;
                                            com.twelvemonkeys.common.io;
                                        </requires>
                                        <exports>
                                            com.twelvemonkeys.imageio;
                                            com.twelvemonkeys.imageio.color;
                                            com.twelvemonkeys.imageio.stream;
                                            com.twelvemonkeys.imageio.util;
                                            com.twelvemonkeys.imageio.spi;
                                        </exports>
                                    </moduleInfo>
                                </module>
                                <!-- Module: com.twelvemonkeys.imageio.metadata -->
                                <module>
                                    <artifact>
                                        <groupId>com.twelvemonkeys.imageio</groupId>
                                        <artifactId>imageio-metadata</artifactId>
                                    </artifact>
                                    <moduleInfo>
                                        <name>com.twelvemonkeys.imageio.metadata</name>
                                        <requires>
                                            static java.desktop;
                                            transitive com.twelvemonkeys.imageio.core;
                                        </requires>
                                    </moduleInfo>
                                </module>
                                <!-- Module: com.twelvemonkeys.imageio.webp -->
                                <module>
                                    <artifact>
                                        <groupId>com.twelvemonkeys.imageio</groupId>
                                        <artifactId>imageio-webp</artifactId>
                                    </artifact>
                                    <moduleInfo>
                                        <name>com.twelvemonkeys.imageio.webp</name>
                                        <requires>
                                            static java.desktop;
                                            transitive com.twelvemonkeys.core;
                                            transitive com.twelvemonkeys.imageio.metadata;
                                        </requires>
                                        <exports>com.twelvemonkeys.imageio.plugins.webp;</exports>
                                    </moduleInfo>
                                </module>
                            </modules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.2.1</version>
                <executions>
                    <execution>
                        <id>attach-source</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <phase>package</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>2.0.0</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>


            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <!-- Run the Application (mvn exec:java@run) -->
                    <execution>
                        <id>run</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>lpfx/ink.meodinger.lpfx.LauncherKt</mainClass>
                            <arguments>
                                <argument>--disable-jni</argument>
                                <argument>--no-check-update</argument>
                            </arguments>
                            <systemProperties>
                                <systemProperty>
                                    <key>prism.verbose</key>
                                    <value>true</value>
                                </systemProperty>
                            </systemProperties>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-sw</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>lpfx/ink.meodinger.lpfx.LauncherKt</mainClass>
                            <arguments>
                                <argument>--disable-jni</argument>
                                <argument>--no-check-update</argument>
                            </arguments>
                            <systemProperties>
                                <systemProperty>
                                    <key>prism.verbose</key>
                                    <value>true</value>
                                </systemProperty>
                                <systemProperty>
                                    <key>prism.order</key>
                                    <value>sw</value>
                                </systemProperty>
                            </systemProperties>
                        </configuration>
                    </execution>
                    <!-- Run the dic (mvn exec:java@run-bat) -->
                    <execution>
                        <id>dict</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>lpfx/ink.meodinger.lpfx.LauncherKt</mainClass>
                            <arguments>
                                <argument>--disable-jni</argument>
                                <argument>--no-check-update</argument>
                                <argument>--dictionary</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Run the bat (mvn exec:java@run-bat) -->
                    <execution>
                        <id>run-bat</id> <!-- ID -->
                        <phase>deploy</phase> <!-- runtime-->
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>cmd</executable>
                            <arguments>
                                <argument>/c</argument>
                                <argument>build.bat</argument>
                                <argument>${project.version}</argument><!-- runtime-->
                            </arguments>
                            <workingDirectory>${project.basedir}/script/jpackage</workingDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Export JARs prepare for bundle -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.1.2</version>
                <executions>
                    <execution>
                        <id>copy-main</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>${project.groupId}</groupId>
                                    <artifactId>${project.artifactId}</artifactId>
                                    <version>${project.version}</version>
                                    <type>jar</type>
                                    <overWrite>true</overWrite>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}/build</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>copy-deps</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/build</outputDirectory>
                            <excludeArtifactIds>junit,hamcrest-core,kotlin-stdlib-common,annotations
                            </excludeArtifactIds>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>